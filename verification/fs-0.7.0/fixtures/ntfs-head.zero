# The exact NTFS driver below runs unchanged in the guest and this harness.
:reserve[65536] => @memory.
:reserve[1024] => @input.
0 => @state.
0 => @current.
0 => @pointer.
0 => @character.
0 => @i.
0 => @j.
0 => @k.
0 => @temporary.
0 => @status.
0 => @timeout.
0 => @ready.
0 => @valid.
0 => @done.
0 => @checksum.
0 => @c0.
0 => @c1.
0 => @c2.
0 => @c3.
0 => @c4.
0 => @c5.
0 => @io_lba.
0 => @io_buffer.
0 => @io_count.
0 => @io_write.
0 => @io_return.
0 => @io_ok.
0 => @writes.
0 => @reads.
0 => @flushes.
0 => @length.
0 -> @i. ?? @i < 65536 [ !store8[@memory + @i| 0]. @i + 1 -> @i. ]
:read[@input| 1024] -> @length.
? (@length < 3) + (@length > 1024) [ !exit[70]. ]
2 -> @i. ?? (@i < @length) * (:load8[@input + @i] != 10) [ @i + 1 -> @i. ]
? @i == @length [ !exit[71]. ]
!store64[@memory + 24576| :load8[@input] - 48].
!store64[@memory + 24584| @input + 2]. !store64[@memory + 24592| @i - 2].
!store64[@memory + 24600| @input + @i + 1]. !store64[@memory + 24608| @length - @i - 1].
!store64[@memory + 24616| @memory + 14336]. !store64[@memory + 24624| 2044].
!store64[@memory + 24648| 900]. !store64[@memory + 24656| 67584].
!store64[@memory + 24664| 131072]. !store64[@memory + 24672| 2].
300 -> @state.
?? @state != 900 [
 @state -> @current.
 ? @current == 90 [
  0 -> @io_ok.
  ? @io_write == 0 [
   :pread[3| @io_buffer| @io_count * 512| @io_lba * 512] -> @temporary.
   ? @temporary == @io_count * 512 [ 1 -> @io_ok. ]
   @reads + 1 -> @reads.
  ]
  ? @io_write == 1 [
   # Input byte1='1'..'9' fails that write before changing the image.
   ? @writes + 49 != :load8[@input + 1] [
    :pwrite[3| @io_buffer| @io_count * 512| @io_lba * 512] -> @temporary.
    ? @temporary == @io_count * 512 [ 1 -> @io_ok. ]
   ]
   @writes + 1 -> @writes.
  ]
  ? @io_write == 2 [
   # Input byte1='a'..'d' fails that durability barrier.
   ? @flushes + 97 != :load8[@input + 1] [ ? :fsync[3] == 0 [ 1 -> @io_ok. ] ]
   @flushes + 1 -> @flushes.
  ]
  @io_return -> @state.
 ]
