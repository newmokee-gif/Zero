  !store64[@pointer + 56| 0x475054304f52455a]. !store64[@pointer + 64| 0x0000000000000007].
  !store64[@pointer + 72| 2]. !store32[@pointer + 80| 128]. !store32[@pointer + 84| 128].
  ? @i [
