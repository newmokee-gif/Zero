 0 -> @round. ?? @round < 3 [
  @memory + 4096 -> @pointer. 16384 -> @length.
  ? @round [ @memory + @round * 512 -> @pointer. 92 -> @length. ]
  0xffffffff -> @checksum. 0 -> @i.
  ?? @i < @length [
   :bitxor[@checksum| :load8[@pointer + @i]] -> @checksum.
   0 -> @j. ?? @j < 8 [
