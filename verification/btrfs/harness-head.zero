!store64[@memory + 24648| 999].
!store64[@memory + 24656| :load64[@memory + 8]].
!store64[@memory + 24664| 524288].
400 -> @state.
?? @state != 999 [
 @state -> @current.
 ? @current == 90 [
  1 -> @io_ok.
  ? @io_write [
   !store64[@memory + 1024| :load64[@memory + 1024] + 1].
   ? :load64[@memory + 1024] == :load8[@memory + 6] [ 0 -> @io_ok. ]
