0 -> @i. ?? @i < 65536 [ !store8[@memory + @i| 0]. @i + 1 -> @i. ]
:read[@memory| 512] -> @i.
? @i != 512 [ !exit[70]. ]
!store64[@memory + 24576| :load8[@memory]].
!store64[@memory + 24584| @memory + 16].
!store64[@memory + 24592| :load8[@memory + 1]].
!store64[@memory + 24600| @memory + 64].
!store64[@memory + 24608| :load16[@memory + 2]].
!store64[@memory + 24616| @memory + 14336].
!store64[@memory + 24624| 2044].
