:reserve[2048] => @console.
:reserve[512] => @arguments.
:reserve[1024016] => @guarded.
@guarded + 8 => @frame.
17 => @operation.
0 => @pointer.
0 => @valid.
0 => @j.
0 => @temporary.
0 => @k.
0 => @done.
0 => @character.
0 => @c0.
0 => @c1.
0 => @c2.
0 => @c3.
0 => @message.
0 => @size.
0 => @changed.
0 => @pixel.
0 => @position.
0 => @mode.
0 -> @j.
?? @j < 2048 [ !store8[@console + @j | 0]. @j + 1 -> @j. ]
!store64[@console | 2].
!store64[@console + 8 | @frame].
!store64[@console + 16 | 640].
!store64[@console + 24 | 400].
!store64[@console + 32 | 640].
!store64[@guarded | 0x0123456789abcdef].
!store64[@frame + 1024000 | 0xfedcba9876543210].
0 -> @j.
?? @j < 1024000 [ !store32[@frame + @j | 0x12345678]. @j + 4 -> @j. ]
0 -> @size. 0 -> @done.
?? @done == 0 [
 :read[@arguments + @size | 511 - @size] -> @temporary.
 ? @temporary > 511 - @size [ !exit[80]. ]
 ? @temporary == 0 [ 1 -> @done. ]
 @size + @temporary -> @size.
 ? @size == 511 [ !exit[81]. ]
]
!store8[@arguments + @size | 0].
? @size < 2 [ !exit[82]. ]
:load8[@arguments] - 48 -> @mode.
!store64[@console + 40 | @mode].
@arguments + 2 -> @arguments.
  ? @operation == 17 [
   @arguments -> @pointer. 1 -> @valid. 0 -> @j.
   ?? @j < 5 [
    0 -> @temporary. 0 -> @k. 0 -> @done.
    ?? @done == 0 [
     :load8[@pointer] -> @character.
     ? (@character >= 48) * (@character <= 57) [
      ? @valid [ @temporary * 10 + @character - 48 -> @temporary. ]
      ? @temporary > 8192 [ 0 -> @valid. ]
      @k + 1 -> @k. @pointer + 1 -> @pointer.
     ] ~ [ 1 -> @done. ]
    ]
    ? @k == 0 [ 0 -> @valid. ]
    !store64[@console + 1024 + @j * 8| @temporary].
    ? @j < 4 [ ? :load8[@pointer] != 32 [ 0 -> @valid. ] ]
    ?? :load8[@pointer] == 32 [ @pointer + 1 -> @pointer. ]
    @j + 1 -> @j.
   ]
   ? :load8[@pointer] [ 0 -> @valid. ]
   ? :load64[@console] != 2 [ 0 -> @valid. ]
   ? :load64[@console + 1024] >= :load64[@console + 16] [ 0 -> @valid. ]
   ? :load64[@console + 1032] >= :load64[@console + 24] [ 0 -> @valid. ]
   ? :load64[@console + 1040] > 255 [ 0 -> @valid. ]
   ? :load64[@console + 1048] > 255 [ 0 -> @valid. ]
   ? :load64[@console + 1056] > 255 [ 0 -> @valid. ]
   ? @valid [
    :load64[@console + 1040] -> @c0. :load64[@console + 1048] -> @c1. :load64[@console + 1056] -> @c2.
    @c0 * 65536 + @c1 * 256 + @c2 -> @c3.
    ? :load64[@console + 40] == 0 [ @c2 * 65536 + @c1 * 256 + @c0 -> @c3. ]
    !store32[:load64[@console + 8] + (:load64[@console + 1032] * :load64[@console + 32] + :load64[@console + 1024]) * 4| @c3].
    "Pixel written.\r\n" -> @message.
   ] ~ [ "Use pixel X Y R G B; valid coordinates, RGB0..255.\r\n" -> @message. ]
  ]
? :load64[@guarded] != 0x0123456789abcdef [ !exit[83]. ]
? :load64[@frame + 1024000] != 0xfedcba9876543210 [ !exit[84]. ]
0 -> @j.
?? @j < 1024000 [
 ? :load32[@frame + @j] != 0x12345678 [
  @changed + 1 -> @changed.
  :load32[@frame + @j] -> @pixel.
  @j -> @position.
 ]
 @j + 4 -> @j.
]
? @changed != @valid [ !exit[85]. ]
!store8[@console | @valid].
!store8[@console + 1 | @changed].
!store32[@console + 2 | @pixel].
!store32[@console + 6 | @position].
:write[@console | 10] -> @temporary.
? @temporary != 10 [ !exit[86]. ]
!exit[0].
