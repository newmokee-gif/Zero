# Own full-slot loading probe. The test driver substitutes the compiled
# string's file offset for ANCHOR_OFFSET before the second compilation.
:arg0[] => @boot.
"ZERO480K_UNIQUE_ANCHOR" => @anchor.
@anchor-62 => @base.
:reserve[65536] => @arena.
:load64[@boot+112] => @pool.
:load64[@boot+120] => @poolBytes.
1 => @good.
:load64[@boot+128] => @bundle.
:load64[@boot+144] => @workspace.
0 => @checksum.
0 => @offset.
0 => @index.
0 => @wait.
0 => @status.
"BOOT480 BUNDLE/WORKSPACE/TAIL FAIL\r\n" => @message.
? :load64[@boot+24] != 120 [ 0 -> @good. ]
? :load64[@boot+96] == 1 [
    ? @pool != 0x100000 [ 0 -> @good. ]
    ? @poolBytes != 0x300000 [ 0 -> @good. ]
] ~ [
    ? :load64[@boot+96] != 2 [ 0 -> @good. ]
    ? @poolBytes != 0x100000 [ 0 -> @good. ]
]
? @pool == 0 [ 0 -> @good. ]
? @pool+@poolBytes <= @pool [ 0 -> @good. ]
? @arena < @pool [ 0 -> @good. ]
? @arena+65536 > @pool+@poolBytes [ 0 -> @good. ]
? :load8[@base+131071] != 49 [ 0 -> @good. ]
? :load8[@base+131072] != 50 [ 0 -> @good. ]
? :load8[@base+262143] != 51 [ 0 -> @good. ]
? :load8[@base+262144] != 52 [ 0 -> @good. ]
? :load8[@base+393215] != 53 [ 0 -> @good. ]
? :load8[@base+393216] != 54 [ 0 -> @good. ]
? :load8[@base+491519] != 90 [ 0 -> @good. ]
? @good [
    !store8[@arena|0x41].
    !store8[@arena+65535|0x42].
    !store8[@pool|0x43].
    ? :load8[@arena] != 0x41 [ 0 -> @good. ]
    ? :load8[@arena+65535] != 0x42 [ 0 -> @good. ]
    ? :load8[@pool] != 0x43 [ 0 -> @good. ]
]
? :load64[@boot+136] != 1048576 [ 0 -> @good. ]
? :load64[@boot+152] != 8388608 [ 0 -> @good. ]
? @bundle == 0 [ 0 -> @good. ]
? @workspace == 0 [ 0 -> @good. ]
? @bundle+1048576 <= @bundle [ 0 -> @good. ]
? @workspace+8388608 <= @workspace [ 0 -> @good. ]
? (@bundle < @workspace+8388608)*(@workspace < @bundle+1048576) [ 0 -> @good. ]
? (@pool < @workspace+8388608)*(@workspace < @pool+@poolBytes) [ 0 -> @good. ]
? (@pool < @bundle+1048576)*(@bundle < @pool+@poolBytes) [ 0 -> @good. ]
? :load64[@boot+96] == 1 [
    ? @bundle != 0x400000 [ 0 -> @good. ]
    ? @workspace != 0x800000 [ 0 -> @good. ]
]
? @good [
    ?? @offset < 1048576 [
        @checksum+(@offset+1)*:load8[@bundle+@offset] -> @checksum.
        @offset+1 -> @offset.
    ]
    ? @checksum != 13180328296002 [ 0 -> @good. ] # BUNDLE_CHECKSUM
    0 -> @offset. 1 -> @status.
    ?? @offset < 8388608 [
        !store8[@workspace+@offset|@status].
        !store8[@workspace+@offset+4095|@status+1].
        @offset+4096 -> @offset. @status+1 -> @status.
        ? @status > 251 [ 1 -> @status. ]
    ]
    0 -> @offset. 1 -> @status.
    ?? @offset < 8388608 [
        ? :load8[@workspace+@offset] != @status [ 0 -> @good. ]
        ? :load8[@workspace+@offset+4095] != @status+1 [ 0 -> @good. ]
        @offset+4096 -> @offset. @status+1 -> @status.
        ? @status > 251 [ 1 -> @status. ]
    ]
]
? @good [ "BOOT480 BUNDLE/WORKSPACE/TAIL PASS\r\n" -> @message. ]
?? :load8[@message+@index] != 0 [
    0 -> @wait. 0 -> @status.
    ?? (@status < 32)*(@wait < 1000000) [
        :in8[0x3fd] -> @status.
        ?? @status >= 64 [ @status-64 -> @status. ]
        @wait+1 -> @wait.
    ]
    !out8[0x3f8|:load8[@message+@index]].
    @index+1 -> @index.
]
? @good [ !out8[0xf4|0]. ] ~ [ !out8[0xf4|1]. ]
!halt.
