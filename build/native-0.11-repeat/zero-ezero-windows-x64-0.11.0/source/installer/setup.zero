 :dirempty[@directory] -> @status. ? @status != 0 [ 1 -> @cleanup_error. ]
 ? @cleanup_error [ "Preparation failed; newly created files could not all be removed. Inspect the destination.\n" -> @message. ]
]
? (@error == 0)*(@action == 1) [ "Prepared and verified: system.iso, storage.data and zero.install.\nBoot integration: NOT INSTALLED. No host boot entry or partition was changed.\n" -> @message. ]
? (@error == 0)*(@action == 2)*(@version == 1) [ "Preparation verified. ISO and initial ZeroFS data checksums match.\nBoot integration: NOT INSTALLED. This directory is not a boot installation.\n" -> @message. ]
? (@error == 0)*(@action == 4) [ "Deployed and verified: ZEROX64.EFI, system.iso, storage.data and zero.install.\nUEFI file launch: select ZEROX64.EFI on a firmware-readable volume.\nNo firmware entry was registered. Host-file data persistence is NOT IMPLEMENTED.\n" -> @message. ]
? (@error == 0)*(@action == 2)*(@version == 2) [
 "UEFI files verified. Initial ZeroFS data is unchanged.\nSelect ZEROX64.EFI on a firmware-readable volume; no boot entry is registered.\nHost-file data persistence is NOT IMPLEMENTED.\n" -> @message.
 ? @data_changed [ "UEFI files verified. Modified ZeroFS data is valid and preserved.\nSelect ZEROX64.EFI on a firmware-readable volume; no boot entry is registered.\nHost-file data persistence is NOT IMPLEMENTED.\n" -> @message. ]
 ? @bank_count == 1 [ "UEFI files verified. ZeroFS has one valid snapshot; data is preserved.\nSelect ZEROX64.EFI on a firmware-readable volume; no boot entry is registered.\nHost-file data persistence is NOT IMPLEMENTED.\n" -> @message. ]
]
0 -> @i. ?? :load8[@message+@i] [ !put[:load8[@message+@i]]. @i+1 -> @i. ]
!exit[@error].
