:reserve[2048] => @templates.
0 => @i.
?? @i < 2048 [ !store64[@templates + @i | 0]. @i + 8 -> @i. ]
# Original value-operation encodings, authored directly as Zero data.
# 77 bitxor: EAX = ECX XOR EAX.
!store64[@templates + 1232 | "6631c8"].
!store64[@templates + 1240 | 3].
# 78 bitand: EAX = ECX AND EAX.
!store64[@templates + 1248 | "6621c8"].
!store64[@templates + 1256 | 3].
# 79 shr: logical u32 shift; count >=32 returns0.
!store64[@templates + 1264 | "66916683f920730566d3e8eb036631c0"].
!store64[@templates + 1272 | 16].
:reserve[1024] => @output.
0 => @out.
0 => @j.
0 => @str.
0 => @len.
0 => @a.
0 => @b.
75 -> @i.
?? @i < 80 [
 :load64[@templates + @i * 16] -> @str.
 :load64[@templates + @i * 16 + 8] -> @len.
 0 -> @j.
 ?? @j < @len [
  :load8[@str + @j * 2] -> @a.
  :load8[@str + @j * 2 + 1] -> @b.
  ? @a < 58 [ @a - 48 -> @a. ] ~ [ @a - 87 -> @a. ]
  ? @b < 58 [ @b - 48 -> @b. ] ~ [ @b - 87 -> @b. ]
  !store8[@output + @out | @a * 16 + @b].
  @out + 1 -> @out. @j + 1 -> @j.
 ]
 @i + 1 -> @i.
]
:write[@output | @out] => @written.
? @written != @out [ !exit[1]. ]
