:reserve[2048] => @templates.
0 => @i.
?? @i < 2048 [ !store64[@templates + @i | 0]. @i + 8 -> @i. ]
# Original value-operation encodings, authored directly as Zero data.
# 77 bitxor: EDX:EAX = EBX:ECX XOR EDX:EAX.
!store64[@templates + 1232 | "31c831da"].
!store64[@templates + 1240 | 4].
# 78 bitand: EDX:EAX = EBX:ECX AND EDX:EAX.
!store64[@templates + 1248 | "21c821da"].
!store64[@templates + 1256 | 4].
# 79 shr: logical u64 shift; high count word or count >=64 returns0.
!store64[@templates + 1264 | "85d2752183f840731c89da89cb89c189d883f92073070fadd0d3eaeb0c89d031d2d3e8eb0431c031d2"].
!store64[@templates + 1272 | 41].
:reserve[1024] => @output.
0 => @out.
0 => @j.
0 => @str.
0 => @len.
0 => @a.
0 => @b.
75 -> @i.
?? @i < 80 [
 :load64[@templates + @i * 16] -> @str.
 :load64[@templates + @i * 16 + 8] -> @len.
 0 -> @j.
 ?? @j < @len [
  :load8[@str + @j * 2] -> @a.
  :load8[@str + @j * 2 + 1] -> @b.
  ? @a < 58 [ @a - 48 -> @a. ] ~ [ @a - 87 -> @a. ]
  ? @b < 58 [ @b - 48 -> @b. ] ~ [ @b - 87 -> @b. ]
  !store8[@output + @out | @a * 16 + @b].
  @out + 1 -> @out. @j + 1 -> @j.
 ]
 @i + 1 -> @i.
]
:write[@output | @out] => @written.
? @written != @out [ !exit[1]. ]
