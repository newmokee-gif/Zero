  ? @operation > 8 [ "Unknown window action." -> @message. ]
  ? @ready [
   @c0 + @c4 * 8192 -> @c5.
   !store64[@console + 2064| @c4]. !store64[@console + 2112| @c5].
   @c5 + 256 -> @line.
   :load64[@c5 + 32] -> @line_length.
