 ] ~ [ "Window manager unavailable: no safe memory pool." -> @message. ]
 ? @message [
  # Error output must not consume or alter a partially typed command.
  # Re-emit its prompt/input after the diagnostic, using bounded scratch.
  !store8[@listing| 13]. !store8[@listing + 1| 10]. 2 -> @i. 0 -> @j.
  ?? :load8[@message + @j] [
