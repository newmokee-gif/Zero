var buffer = reserve(97);
var count = 1;
var status = 0;
var emitted = 0;
while count != 0 {
    count = read(buffer,97);
    if count == -4 { count=1; } else {
        if count > 97 { exit(1); }
        emitted=0;
        while emitted < count {
            status=write(buffer+emitted,count-emitted);
            if status != -4 {
                if status == 0 { exit(2); }
                if status > count-emitted { exit(2); }
                emitted=emitted+status;
            }
        }
    }
}
exit(0);
