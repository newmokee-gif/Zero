# Entire UEFI loader in Zero. Firmware is an external platform interface.
var image = arg0;
var system = arg1;
var services = load64(system + 96);
var status = 0;
var scratch = reserve(1024);
var guid = scratch;
var result = scratch + 32;
var rootOut = scratch + 40;
var fileOut = scratch + 48;
var sizeOut = scratch + 56;
var path = scratch + 80;
var fileInfo = scratch + 256;
var text = "ZERO loader: UEFI -> own kernel\r\n";
var index = 0;
var ch = 0;
var protocol = 0;
var device = 0;
var root = 0;
var file = 0;
var fileSize = 0;
var code = 0;
var received = 0;
var stack = 0;
var handoff = 0;
var map = 0;
var attempts = 0;
var step = 0;
var done = 0;
var uart = 0;
var wait = 0;
var serial = 1;
var gop = 0;
var mode = 0;
var modeInfo = 0;
var maxMode = 0;
var candidate = 0;
var chosenMode = 0xffffffff;
var gopStatus = 0;
var width = 0;
var height = 0;
var stride = 0;
var pixelKind = 0;
var frameBuffer = 0;
var frameBytes = 0;
var screenValid = 0;
# Own UART setup for loader diagnostics.
out8(0x3f9,0);
out8(0x3fb,128);
out8(0x3f8,1);
out8(0x3f9,0);
out8(0x3fb,3);
out8(0x3fa,199);
out8(0x3fc,11);
uart=in8(0x3fd);
if uart == 255 { serial=0; }
while (load8(text+index) != 0) * serial {
    uart=0; wait=0;
    while (uart < 32) * serial {
        uart=in8(0x3fd);
        if uart >= 128 { uart=uart-128; }
        if uart >= 64 { uart=uart-64; }
        wait=wait+1;
        if wait > 1000000 { serial=0; }
    }
    if serial { out8(0x3f8,load8(text+index)); }
    index=index+1;
}
# Disable firmware watchdog before leaving firmware.
status=call(load64(services+256),0,0,0,0,0);
if status == 0 {
    step=1;
    # EFI_LOADED_IMAGE_PROTOCOL on this application handle.
    store64(guid,0x11d295625b1b31a1);
    store64(guid+8,0x3b7269c9a0003f8e);
    store64(result,0);
    status=call(load64(services+152),image,guid,result,0,0);
}
if status == 0 {
    protocol=load64(result);
    device=load64(protocol+24);
    step=2;
    store64(guid,0x11d26459964e5b22);
    store64(guid+8,0x3b7269c9a000398e);
    store64(result,0);
    status=call(load64(services+152),device,guid,result,0,0);
}
if status == 0 {
    protocol=load64(result);
    step=3;
    store64(rootOut,0);
    status=call(load64(protocol+8),protocol,rootOut,0,0,0);
}
if status == 0 {
    root=load64(rootOut);
    text="\\kernel.bin";
    index=0;
    while load8(text+index) != 0 {
        store16(path+index*2,load8(text+index));
        index=index+1;
    }
    store16(path+index*2,0);
    step=4;
    store64(fileOut,0);
    status=call(load64(root+8),root,fileOut,path,1,0);
}
if status == 0 {
    file=load64(fileOut);
    step=5;
    store64(guid,0x11d26d3f09576e92);
    store64(guid+8,0x3b7269c9a000398e);
    store64(sizeOut,512);
    status=call(load64(file+64),file,guid,sizeOut,fileInfo,0);
    if status == 0 {
        fileSize=load64(fileInfo+8);
        if fileSize == 0 { status=0x8000000000000001; }
        if fileSize > 131072 { status=0x8000000000000001; }
    }
}
if status == 0 {
    step=6;
    store64(result,0);
    status=call(load64(services+40),0,1,32,result,0);
    code=load64(result);
}
# File completion has its own flag; no EFI warning can mean completion.
while done == 0 {
    if status != 0 { done=1; } else {
        if received == fileSize { done=1; } else {
            step=7;
            store64(sizeOut,fileSize-received);
            status=call(load64(file+32),file,sizeOut,code+received,0,0);
            if status == 0 {
                ch=load64(sizeOut);
                if ch == 0 { status=0x8000000000000001; }
                if ch > fileSize-received { status=0x8000000000000001; }
                if status == 0 { received=received+ch; }
            }
        }
    }
}
if status == 0 {
    step=8;
    status=call(load64(file+16),file,0,0,0,0);
    if status == 0 { status=call(load64(root+16),root,0,0,0,0); }
}
if status == 0 {
    step=9;
    store64(result,0);
    status=call(load64(services+40),0,2,64,result,0);
    stack=load64(result);
}
if status == 0 {
    step=10;
    store64(result,0);
    status=call(load64(services+40),0,2,17,result,0);
    handoff=load64(result);
    map=handoff+4096;
}
if status == 0 {
    # The handoff is LoaderData, not implicitly initialized firmware memory.
    index=0;
    while index < 112 { store64(handoff+index,0); index=index+8; }
    store64(handoff+96,2);
    store64(handoff+104,64);
    # Obtain GOP while firmware services are still available. Failure leaves
    # display kind zero, preserving serial-only operation on headless systems.
    store64(guid,0x4a3823dc9042a9de);
    store64(guid+8,0x6a5180d0de7afb96);
    store64(result,0);
    gopStatus=call(load64(services+320),guid,0,result,0,0);
    if gopStatus == 0 { gop=load64(result); }
    if gop {
        mode=load64(gop+24);
        if mode {
            maxMode=load32(mode);
            # Preserve a suitable current mode to avoid needless mode resets.
            modeInfo=load64(mode+8);
            if modeInfo {
                if load64(mode+16) >= 36 {
                    width=load32(modeInfo+4);
                    height=load32(modeInfo+8);
                    stride=load32(modeInfo+32);
                    screenValid=1;
                    if load32(modeInfo) != 0 { screenValid=0; }
                    if width < 640 { screenValid=0; }
                    if width > 1024 { screenValid=0; }
                    if height < 400 { screenValid=0; }
                    if height > 768 { screenValid=0; }
                    if stride < width { screenValid=0; }
                    if stride > 16384 { screenValid=0; }
                    if load32(modeInfo+12) > 1 { screenValid=0; }
                    frameBuffer=load64(mode+24);
                    frameBytes=stride*height*4;
                    if frameBuffer == 0 { screenValid=0; }
                    if frameBytes > load64(mode+32) { screenValid=0; }
                    if frameBuffer+frameBytes <= frameBuffer { screenValid=0; }
                    if load32(mode+4) >= maxMode { screenValid=0; }
                    if screenValid { chosenMode=load32(mode+4); }
                }
            }
            candidate=0;
            # QueryMode allocates Info. Free it on every successful query;
            # only values copied to our own variables survive FreePool.
            while (candidate < maxMode) * (candidate < 256) * (chosenMode == 0xffffffff) {
                store64(scratch+64,0);
                store64(scratch+72,0);
                gopStatus=call(load64(gop),gop,candidate,scratch+64,scratch+72,0);
                if gopStatus == 0 {
                    modeInfo=load64(scratch+72);
                    if modeInfo {
                        screenValid=0;
                        if load64(scratch+64) >= 36 {
                            width=load32(modeInfo+4);
                            height=load32(modeInfo+8);
                            stride=load32(modeInfo+32);
                            screenValid=1;
                            if load32(modeInfo) != 0 { screenValid=0; }
                            if width < 640 { screenValid=0; }
                            if width > 1024 { screenValid=0; }
                            if height < 400 { screenValid=0; }
                            if height > 768 { screenValid=0; }
                            if stride < width { screenValid=0; }
                            if stride > 16384 { screenValid=0; }
                            if load32(modeInfo+12) > 1 { screenValid=0; }
                        }
                        gopStatus=call(load64(services+72),modeInfo,0,0,0,0);
                        if gopStatus != 0 { screenValid=0; candidate=256; }
                        if screenValid { chosenMode=candidate; }
                    }
                }
                candidate=candidate+1;
            }
            if chosenMode != 0xffffffff {
                if chosenMode != load32(mode+4) {
                    gopStatus=call(load64(gop+8),gop,chosenMode,0,0,0);
                }
            }
            # Always validate the actual current mode after any attempted
            # SetMode. Never trust stale pointers or queried framebuffer data.
            mode=load64(gop+24);
            if mode {
                modeInfo=load64(mode+8);
                if modeInfo {
                    if load64(mode+16) >= 36 {
                        width=load32(modeInfo+4);
                        height=load32(modeInfo+8);
                        stride=load32(modeInfo+32);
                        pixelKind=load32(modeInfo+12);
                        frameBuffer=load64(mode+24);
                        frameBytes=stride*height*4;
                        screenValid=1;
                        if load32(modeInfo) != 0 { screenValid=0; }
                        if width < 640 { screenValid=0; }
                        if width > 8192 { screenValid=0; }
                        if height < 400 { screenValid=0; }
                        if height > 8192 { screenValid=0; }
                        if stride < width { screenValid=0; }
                        if stride > 16384 { screenValid=0; }
                        if pixelKind > 1 { screenValid=0; }
                        if frameBuffer == 0 { screenValid=0; }
                        if frameBytes > load64(mode+32) { screenValid=0; }
                        if frameBuffer+frameBytes <= frameBuffer { screenValid=0; }
                        if screenValid {
                            store64(handoff+48,2);
                            store64(handoff+56,frameBuffer);
                            store64(handoff+64,width);
                            store64(handoff+72,height);
                            store64(handoff+80,stride);
                            store64(handoff+88,pixelKind);
                        }
                    }
                }
            }
        }
    }
}
if status != 0 {
    text="ZERO loader: failed before exit; stage=";
    index=0;
    while (load8(text+index) != 0) * serial {
        uart=0; wait=0;
        while (uart < 32) * serial {
            uart=in8(0x3fd);
            if uart >= 128 { uart=uart-128; }
            if uart >= 64 { uart=uart-64; }
            wait=wait+1;
            if wait > 1000000 { serial=0; }
        }
        if serial { out8(0x3f8,load8(text+index)); } index=index+1;
    }
    # Format stages 0..10 in decimal and poll before every diagnostic byte.
    index=0;
    if step == 10 { store8(path,49); index=1; step=0; }
    store8(path+index,48+step);
    store8(path+index+1,13);
    store8(path+index+2,10);
    store8(path+index+3,0);
    index=0;
    while (load8(path+index) != 0) * serial {
        uart=0; wait=0;
        while (uart < 32) * serial {
            uart=in8(0x3fd);
            if uart >= 128 { uart=uart-128; }
            if uart >= 64 { uart=uart-64; }
            wait=wait+1;
            if wait > 1000000 { serial=0; }
        }
        if serial { out8(0x3f8,load8(path+index)); } index=index+1;
    }
    halt;
}
# Handoff header +0 size, +8 stride, +16 map, +24 code pages;
# +32 map key, +40 descriptor version. All in our allocated LoaderData.
store64(handoff+16,map);
store64(handoff+24,32);
text="ZERO loader: leaving boot services\r\n";
index=0;
while (load8(text+index) != 0) * serial {
    uart=0; wait=0;
    while (uart < 32) * serial {
        uart=in8(0x3fd);
        if uart >= 128 { uart=uart-128; }
        if uart >= 64 { uart=uart-64; }
        wait=wait+1;
        if wait > 1000000 { serial=0; }
    }
    if serial { out8(0x3f8,load8(text+index)); } index=index+1;
}
# After the first attempt only GetMemoryMap/ExitBootServices may use firmware.
# Retry within the preallocated 64 KiB map; diagnostics use our UART only.
done=0;
while done == 0 {
    store64(handoff,65536);
    status=call(load64(services+56),handoff,map,handoff+32,handoff+8,handoff+40);
    if status != 0 {
        text="ZERO loader: GetMemoryMap failed\r\n";
        done=1;
    } else {
        if load64(handoff) > 65536 { done=1; }
        if load64(handoff+8) < 40 { done=1; }
        if load64(handoff+8) > load64(handoff) { done=1; }
        if done != 0 {
            text="ZERO loader: invalid memory map\r\n";
        } else {
            status=call(load64(services+232),image,load64(handoff+32),0,0,0);
            if status == 0 {
                enter(code,handoff,stack+262144);
            }
            attempts=attempts+1;
            if status != 0x8000000000000002 {
                text="ZERO loader: ExitBootServices failed\r\n";
                done=1;
            } else {
                if attempts == 4 {
                    text="ZERO loader: ExitBootServices retry limit\r\n";
                    done=1;
                }
            }
        }
    }
}
index=0;
while (load8(text+index) != 0) * serial {
    uart=0; wait=0;
    while (uart < 32) * serial {
        uart=in8(0x3fd);
        if uart >= 128 { uart=uart-128; }
        if uart >= 64 { uart=uart-64; }
        wait=wait+1;
        if wait > 1000000 { serial=0; }
    }
    if serial { out8(0x3f8,load8(text+index)); } index=index+1;
}
halt;
