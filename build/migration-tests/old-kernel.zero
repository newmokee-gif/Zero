 if current == 1 {
  io_lba = 0; io_buffer = bank_a; io_count = 9;
  io_write = 0; io_return = 2; state = 90;
 }
 if current == 2 {
  good_a = 0;
  if io_ok { validate_ptr = bank_a; validate_return = 3; state = 50; }
