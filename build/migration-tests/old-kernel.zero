   message = "ZeroFS mounted. Files survive restart. Type help.\r\n";
  } else {
   if disk_ready {
    message = "No valid ZeroFS disk. Attach dedicated IDE data.img.\r\nUse format ZERO only to erase and initialize that disk. Type help.\r\n";
   } else {
    message = "No supported primary-master IDE disk. Filesystem unavailable.\r\nNeed an ATA LBA disk with 512-byte sectors and FLUSH CACHE. Type help.\r\n";
   }
  }
  state = 9;
 }
 if current == 9 { line_length = 0; overflow = 0; message = "zero> "; state = 10; }
 if current == 10 {
  character = 0;
  if load64(console + 80) {
   status = in8(0x3fd);
   if status == 255 { store64(console + 80, 0); }
   else {
    while status >= 2 { status = status - 2; }
    if status { character = in8(0x3f8); }
   }
  }
  if character == 0 {
   if load64(console + 160) {
    c0 = in8(0x64); c1 = c0;
    while c1 >= 2 { c1 = c1 - 2; }
    if c1 {
     c1 = in8(0x60);
     # Discard auxiliary-port bytes and controller parity/timeout errors.
     if c0 < 32 {
      c0 = c1;
      if c0 == 0xe0 { store64(console + 112, 1); }
      else {
       if c0 == 0xe1 { store64(console + 168, 5); }
       else {
        if load64(console + 168) {
         store64(console + 168, load64(console + 168) - 1);
        } else {
         if c0 >= 128 {
          if c0 == 170 { store64(console + 88, 0); }
          if c0 == 182 { store64(console + 96, 0); }
          if c0 == 186 { store64(console + 176, 0); }
          store64(console + 112, 0);
         } else {
          if c0 == 42 { store64(console + 88, 1); }
          if c0 == 54 { store64(console + 96, 1); }
          if c0 == 58 {
           if load64(console + 176) == 0 {
            store64(console + 104, 1 - load64(console + 104));
            store64(console + 176, 1);
           }
          }
          if load64(console + 112) {
           if c0 == 28 { character = 13; }
           store64(console + 112, 0);
          } else {
           c1 = 0; c2 = 0; c4 = 0;
           c3 = (load64(console + 88) + load64(console + 96)) > 0;
           if (c0 >= 2) * (c0 <= 13) {
            c1 = "1234567890-="; c2 = "!@#$%^&*()_+"; c4 = c0 - 2;
           }
           if (c0 >= 16) * (c0 <= 27) {
            c1 = "qwertyuiop[]"; c2 = "QWERTYUIOP{}"; c4 = c0 - 16;
           }
           if (c0 >= 30) * (c0 <= 41) {
            c1 = "asdfghjkl;'`"; c2 = "ASDFGHJKL:\"~"; c4 = c0 - 30;
           }
           if (c0 >= 43) * (c0 <= 53) {
            c1 = "\\zxcvbnm,./"; c2 = "|ZXCVBNM<>?"; c4 = c0 - 43;
           }
           if c1 {
            character = load8(c1 + c4);
            if (character >= 97) * (character <= 122) {
             if c3 != load64(console + 104) { character = character - 32; }
            } else { if c3 { character = load8(c2 + c4); } }
           }
           if c0 == 14 { character = 8; }
           if c0 == 15 { character = 32; }
           if c0 == 28 { character = 13; }
           if c0 == 57 { character = 32; }
          }
         }
        }
       }
      }
     }
    }
   }
