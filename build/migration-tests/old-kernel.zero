# Own Zero kernel: visible terminal, PS/2/COM1 input and persistent ATA files.
var memory = reserve(24576);
var bank_a = memory;
var bank_b = memory + 4608;
var work = memory + 9216;
var line = memory + 13824;
var listing = memory + 14336;
var echo_byte = memory + 16380;
var state = 0;
var current = 0;
var message = 0;
var pointer = 0;
var character = 0;
var i = 0;
var j = 0;
var k = 0;
var temporary = 0;
var status = 0;
var timeout = 0;
var ready = 0;
var valid = 0;
var done = 0;
var io_lba = 0;
var io_buffer = 0;
var io_count = 0;
var io_write = 0;
var io_return = 0;
var io_ok = 0;
var sector_index = 0;
var word_index = 0;
var command_status = 0;
