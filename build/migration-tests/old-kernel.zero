  while c0 < 32 {
   c1 = in8(0x64);
   while c1 >= 2 { c1 = c1 - 2; }
   if c1 { c2 = in8(0x60); } else { c0 = 32; }
   c0 = c0 + 1;
  }
  c0 = 0;
  while c0 < 9 {
   if load64(console + 160) {
    c1 = 0x64; c2 = 0xad;
    if c0 == 1 { c2 = 0xa7; }
    if c0 == 2 { c2 = 0x60; }
    if c0 == 3 { c1 = 0x60; c2 = 0x64; }
    if c0 == 4 { c2 = 0xae; }
    if c0 == 5 { c1 = 0x60; c2 = 0xf5; }
    if c0 == 6 { c1 = 0x60; c2 = 0xf0; }
    if c0 == 7 { c1 = 0x60; c2 = 2; }
    if c0 == 8 { c1 = 0x60; c2 = 0xf4; }
