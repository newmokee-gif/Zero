      store8(listing + j, 13); j = j + 1; store8(listing + j, 10); j = j + 1;
     }
     slot = slot + 1;
    }
    store8(listing + j, 0); message = listing;
    if j == 0 { message = "No files.\r\n"; }
   } else { message = "Filesystem unavailable.\r\n"; }
  }
