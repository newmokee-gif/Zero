var text_length = 0;
var slot = 0;
var boot_information = arg0;
var console = memory + 16384;
# Original 5x7 ASCII glyph rows. Each character stores seven masks as 48+mask.
var font = "00000004444404:::0000:O::O:04?D>5N4IJ248;C<BD8EB=44800002488842842224804E>E40044O4400000448000O0000000004122488@>ACEIA>4<4444>>A1248ON11611N26:BO22O@@N11N68@NAA>O124888>AA>AA>>AA?12<04004000400448124842100O0O00@84248@>A12404>AGEG@>>AAOAAANAANAAN?@@@@@?NAAAAANO@@N@@OO@@N@@@?@@GAA?AAAOAAA>44444>72222B<ABDHDBA@@@@@@OAKEEAAAAIIECCA>AAAAA>NAAN@@@>AAAEB=NAANDBA?@@>11NO444444AAAAAA>AAAAA:4AAAEEKAAA:4:AAAA:4444O1248@O>88888>@884221>22222>4:A0000000000O842000000>1?A?@@NAAAN00?@@@?11?AAA?00>AO@?698N8880?AA?1>@@NAAAA40<444>20622B<@@BDHDB<44444>00JEEEE00NAAAA00>AAA>0NAAN@@0?AA?1100FI@@@00?@>1N88N889600AAAA?00AAA:400AAEE:00A:4:A0AAA?1>00O248O34484434444444H44244H009F000";
var c0 = 0;
var c1 = 0;
var c2 = 0;
var c3 = 0;
var c4 = 0;
var c5 = 0;
i = 0;
while i < 24576 { store8(memory + i, 0); i = i + 1; }
while 1 {
 current = state;
 if current == 0 {
  # Copy only display fields from the firmware-neutral loader handoff.
  if boot_information {
   i = 0;
   while i < 48 {
    store64(console + i, load64(boot_information + 48 + i)); i = i + 8;
   }
  }
  if load64(console) == 1 {
   if load64(console + 8) != 0xb8000 { store64(console, 0); }
  } else {
   if load64(console) == 2 {
    if load64(console + 8) == 0 { store64(console, 0); }
    if load64(console + 16) < 640 { store64(console, 0); }
    if load64(console + 24) < 400 { store64(console, 0); }
    if load64(console + 16) > 8192 { store64(console, 0); }
    if load64(console + 24) > 8192 { store64(console, 0); }
    if load64(console + 32) < load64(console + 16) { store64(console, 0); }
    if load64(console + 32) > 16384 { store64(console, 0); }
    if load64(console + 40) > 1 { store64(console, 0); }
   } else { store64(console, 0); }
  }
  store64(console + 120, 1);
  # COM1 is optional. A missing or stalled UART must not stop visible output.
  out8(0x3f9, 0); out8(0x3fb, 0x80); out8(0x3f8, 1);
  out8(0x3f9, 0); out8(0x3fb, 3); out8(0x3fa, 7); out8(0x3fc, 3);
  out8(0x3ff, 0x5a);
  if in8(0x3ff) == 0x5a { store64(console + 80, 1); }
