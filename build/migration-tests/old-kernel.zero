  else { state = 7; }
 }
 if current == 6 { good_b = validate_good; state = 7; }
 if current == 7 {
  fs_ready = 0; pointer = 0;
  if good_a { pointer = bank_a; active_bank = 0; }
  if good_b {
   if good_a {
    if load64(bank_b + 8) > load64(bank_a + 8) { pointer = bank_b; active_bank = 9; }
   } else { pointer = bank_b; active_bank = 9; }
  }
