     temporary = in8(0x3f6); temporary = in8(0x3f6);
     ready = 0; timeout = 0;
     while ready == 0 {
      status = in8(0x1f7);
      if status == 0 { io_ok = 0; ready = 1; }
      if status == 255 { io_ok = 0; ready = 1; }
      if status < 128 {
       command_status = status;
