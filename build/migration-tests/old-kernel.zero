    while ready == 0 {
     status = in8(0x64);
     while status >= 4 { status = status - 4; }
     if status < 2 { ready = 1; }
     timeout = timeout + 1;
     if timeout == 100000 { ready = 1; store64(console + 160, 0); }
    }
    if load64(console + 160) {
     out8(c1, c2);
     if c0 >= 5 {
      ready = 0; timeout = 0;
      while ready == 0 {
       status = in8(0x64);
       while status >= 2 { status = status - 2; }
       if status {
        c3 = in8(0x60); ready = 1;
        if c3 != 0xfa { store64(console + 160, 0); }
