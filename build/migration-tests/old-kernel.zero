 }
 if current == 3 { good_a = validate_good; state = 4; }
 if current == 4 {
  io_lba = 9; io_buffer = bank_b; io_count = 9;
  io_write = 0; io_return = 5; state = 90;
 }
 if current == 5 {
  good_b = 0;
