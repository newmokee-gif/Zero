?? @n < @count [
 @draws + @n * 64 -> @ptr.
 :load64[@ptr] -> @kind. :load64[@ptr + 8] -> @x. :load64[@ptr + 16] -> @y.
 :load64[@ptr + 24] -> @w. :load64[@ptr + 32] -> @h. :load64[@ptr + 40] -> @color.
