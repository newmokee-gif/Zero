 ? @kind == 1 [
  0 -> @j.
  ?? @j < @h [
   0 -> @i.
   ?? @i < @w [ !store32[@frame + ((@y + @j) * 800 + @x + @i) * 4 | @color]. @i + 1 -> @i. ]
   @j + 1 -> @j.
  ]
 ] ~ [
  0 -> @i.
  ?? :load8[@ptr + @i] [
   :load8[@ptr + @i] -> @ch. 0 -> @j.
   ?? @j < 7 [
    :load8[@font + (@ch - 32) * 7 + @j] - 48 -> @mask. 16 -> @bit. 0 -> @a.
    ?? @a < 5 [
     ? :bitand[@mask | @bit] [
      0 -> @dy.
      ?? @dy < @scale * 2 [
       0 -> @dx.
       ?? @dx < @scale [
        @x + @i * 8 * @scale + @a * @scale + @dx -> @gx.
        @y + @j * 2 * @scale + @dy -> @gy.
        ? (@gx < 800) * (@gy < 600) [ !store32[@frame + (@gy * 800 + @gx) * 4 | @color]. ]
        @dx + 1 -> @dx.
       ]
       @dy + 1 -> @dy.
      ]
     ]
     :shr[@bit | 1] -> @bit. @a + 1 -> @a.
    ]
    @j + 1 -> @j.
   ]
   @i + 1 -> @i.
  ]
 ]
