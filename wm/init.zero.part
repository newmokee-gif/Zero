# BEGIN ZERO WINDOW SESSION INITIALIZATION
# Child stacks occupy pool+0..0x28000; reserve the top128KiB for the main
# stack/arena. Window slots use only the owned, otherwise unused middle.
!store64[@console + 2048| 0]. !store64[@console + 2056| 0].
!store64[@console + 2064| 0]. !store64[@console + 2072| 0].
!store64[@console + 2080| 0]. !store64[@console + 2088| 1].
!store64[@console + 2096| 0]. !store64[@console + 2104| 0].
!store64[@console + 2112| 0].
? @boot_information [
 :load64[@boot_information + 112] -> @c0.
 :load64[@boot_information + 120] -> @c1.
 1 -> @valid.
 ? @c0 == 0 [ 0 -> @valid. ]
 ? :bitand[@c0| 15] [ 0 -> @valid. ]
 ? @c1 < 532480 [ 0 -> @valid. ]
 ? @c0 + @c1 <= @c0 [ 0 -> @valid. ]
 ? :load64[@boot_information + 104] == 32 [
  ? @c0 + @c1 > 4294967296 [ 0 -> @valid. ]
 ]
 ? @valid [
  @c0 + 393216 -> @c2.
  :shr[@c1 - 524288| 13] -> @c3.
  !store64[@console + 2048| @c2]. !store64[@console + 2056| @c3].
  # Only initialize headers of unused slots; allocated slots are fully zeroed
  # before publication. This does not touch either native worker stack.
  0 -> @i.
  ?? @i < @c3 [ !store64[@c2 + @i * 8192| 0]. @i + 1 -> @i. ]
  2 -> @c4. ? @c3 < 2 [ 1 -> @c4. ]
  0 -> @i.
  ?? @i < @c4 [
   @c2 + @i * 8192 -> @c5. 0 -> @j.
   ?? @j < 8192 [ !store64[@c5 + @j| 0]. @j + 8 -> @j. ]
   !store64[@c5 + 8| @i + 1]. !store64[@c5 + 64| 1].
   !store64[@c5 + 56| :load64[@memory + 24688]].
   ? @i == 0 [ !store64[@c5 + 144| 1]. ]
   !store64[@c5| 1].
   @i + 1 -> @i.
  ]
  !store64[@console + 2072| @c4]. !store64[@console + 2112| @c2].
  @c2 + 256 -> @line.
 ]
]
# END ZERO WINDOW SESSION INITIALIZATION
