# Run in a dedicated empty test directory. Native invocation takes that path.
check :: value [
 value => when [ 1 => return ]
 0 - 1 => return
]

host() => when [
 arguments() => paths
 check(size(paths) == 1) => ignored
 go(paths[1]) => ignored
]

check(size(disks()) > 0) => ignored
check(create(zcheck) == 1) => ignored
check(fileexists(zcheck) == 1) => ignored
check(read(zcheck) == empty) => ignored
check(save(zcheck | Old text) == 8) => ignored
check(create(zcheck) == 1) => ignored
check(read(zcheck) == Old text) => ignored
check(save(zcheck | New text) == 8) => ignored
check(readfile(zcheck) == New text) => ignored
check(writefile(zother | Other text) == 10) => ignored
watch(.) => names
check(size(names) == 2) => ignored
search(zcheck) => exact
check(size(exact) == 1) => ignored
check(exact[1] == zcheck) => ignored
search("z*") => matching
check(size(matching) == 2) => ignored
search(no_such_file) => missing
check(size(missing) == 0) => ignored
matching => retained
0 => counter
empty => temporary
6000 => repeat [
 Temporary counter => temporary
 counter + 1 => counter
]
check(size(retained) == 2) => ignored
check(size(names) == 2) => ignored
check(save(zcheck | empty) == 0) => ignored
check(read(zcheck) == empty) => ignored
check(del(zcheck) == 1) => ignored
check(rm(zother) == 1) => ignored
check(fileexists(zcheck) == 0) => ignored
check(size(watch(.)) == 0) => ignored
Files passed => show
