# Run against a directory with exactly 2048 ordinary files.
check :: value [
 value => when [ 1 => return ]
 0 - 1 => return
]
arguments()[1] + empty => root
watch(root) => names
check(size(names) == 2048) => ready
names[1] => retained
retained + empty => expected
empty => names
12 => repeat [
 watch(root) => names
 check(size(names) == 2048) => ready
 check(retained == expected) => ready
 empty => names
]
Listing collection passed => show
