0 => @h_char. 0 => @h_value. 0 => @h_extra. 0 => @h_quote.
0 => @h_tag. 0 => @h_close. 0 => @h_skip. 0 => @h_pre.
0 => @h_space. 0 => @h_column. 0 => @h_active. 0 => @h_titlemode.
0 => @h_titlelen. 0 => @h_labelsize. 0 => @h_state. 0 => @h_return.
0 => @h_break. 0 => @h_ptr. 0 => @h_size. 0 => @h_attr.
