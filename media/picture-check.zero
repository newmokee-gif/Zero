@failures -> @value. 0 -> @digit.
?? @value >= 10 [ @value-10 -> @value. @digit+1 -> @digit. ]
? @digit [ !put[48+@digit]. ] !put[48+@value].
" failed.\n" -> @message.
0 -> @i. ?? :load8[@message+@i] [ !put[:load8[@message+@i]]. @i+1 -> @i. ]
:hostfree[@work|67112960] -> @status.
? @failures [ !exit[1]. ] !exit[0].
