# Actual BIOS optical bounce read, then INT15/AH87 DMA-independent copies.
:arg0[] => @drive.
0 => @status.
0 => @bad.
0 => @i.
0 => @j.
0 => @phase.
0 => @source_address.
0 => @destination_address.
0 => @destination_base.
0 => @words.
0 => @value.
0 => @text.
# Invalid local arguments reject without accessing the descriptor table.
? :biosmove[0xffd1 | 1] != 0xffffffff [ 1 -> @bad. ]
? :biosmove[0x6800 | 0] != 0xffffffff [ 1 -> @bad. ]
? :biosmove[0x6800 | 32769] != 0xffffffff [ 1 -> @bad. ]
# Guard source stays below64KiB; payload is read from optical media to20000.
?? @i < 32 [ !store8[0x6000 + @i | 165]. @i + 1 -> @i. ]
!store32[0x3900 | 0x00100010].
!store16[0x3904 | 0].
!store16[0x3906 | 0x2000].
!store32[0x3908 | 40].
!store32[0x390c | 0].
:bios[@drive | 0x3900] -> @status.
? @status != 0 [ 1 -> @bad. ]
!store32[0x6200 | @status].
0 -> @i.
?? @i < 3 [
 0x400000 -> @destination_base.
 ? @i == 1 [ 0x800000 -> @destination_base. ]
 ? @i == 2 [ 0x2000000 -> @destination_base. ]
 0 -> @phase.
 ?? @phase < 3 [
  0x6000 -> @source_address. 16 -> @words.
  @destination_base - 32 -> @destination_address.
  ? @phase == 1 [ @destination_base + 32768 -> @destination_address. ]
  ? @phase == 2 [ 0x20000 -> @source_address. 16384 -> @words. @destination_base -> @destination_address. ]
  0 -> @j. ?? @j < 48 [ !store8[0x6800 + @j | 0]. @j + 1 -> @j. ]
  !store16[0x6810 | @words * 2 - 1].
  !store16[0x6812 | @source_address].
  !store8[0x6814 | :shr[@source_address | 16]].
  !store8[0x6815 | 0x93].
  !store8[0x6817 | :shr[@source_address | 24]].
  !store16[0x6818 | @words * 2 - 1].
  !store16[0x681a | @destination_address].
  !store8[0x681c | :shr[@destination_address | 16]].
  !store8[0x681d | 0x93].
  !store8[0x681f | :shr[@destination_address | 24]].
  :biosmove[0x6800 | @words] -> @status.
  !store32[0x6210 + @i * 16 + @phase * 4 | @status].
  ? @status != 0 [ 1 -> @bad. ]
  @phase + 1 -> @phase.
 ]
 @i + 1 -> @i.
]
"BIOSMOVE_READY\n" -> @text.
? @bad [ "BIOSMOVE_FAIL\n" -> @text. ]
0 -> @i. ?? :load8[@text + @i] [ !out8[0xe9 | :load8[@text + @i]]. @i + 1 -> @i. ]
!halt.
