 # Windows process entry and own bounded argc/argv parser.
 !store64[@templates + 1120 | ""].
 !store64[@templates + 1128 | 305].
 # ReadFile binary stdin; EOF0, invalid count -22, other errors -5.
 !store64[@templates + 656 | ""].
 !store64[@templates + 664 | 162].
 # WriteFile binary stdout; short count preserved, errors -5.
 !store64[@templates + 672 | "483dffffff7f0f876f00000041544989e44883e4f04883ec5048894c2430488944243848c744242000000000c744242800000000b9f5ffffff41ff97081100004889c1488b542430448b4424384c8d4c242841ff971811000085c00f850c00000048c7c0fbffffffe9040000008b4424284c89e4415ce90700000048c7c0eaffffff"].
 !store64[@templates + 680 | 130].
 # One-byte output; failure terminates with74.
 !store64[@templates + 688 | ""].
 !store64[@templates + 696 | 175].
 # ExitProcess low8 status.
 !store64[@templates + 704 | "0fb6c84883e4f04883ec2041ff97201100000f0b"].
