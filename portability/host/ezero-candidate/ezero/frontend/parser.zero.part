   !store64[@functions + @scope * 64 + 48 | @slot + 1].
  ]
 ]

       @count + 1 -> @count. @pos + 1 -> @pos. 1 -> @w.
      ]
     ] ~ [
      ? :load64[@tokens + @pos * 32] != 124 [ "expected | or [ after parameter" -> @fail. ] ~ [ @pos + 1 -> @pos. 0 -> @w. ]
     ]
    ]
    ? (@count > 0) * (@w == 0) [ "missing parameter after |" -> @fail. ]
    !store64[@functions + @scope * 64 + 40 | @count].
    @pos + 1 -> @pos. 1 -> @bp. 0 -> @state.
   ]
  ]
 ]
