 !store64[@templates + 1616 | "eb0f2f70726f632f73656c662f657865004c89ee4d89e84981c000100000723e488d9500feffff4939d07732488d3dcfffffffba00100000b8590000000f054883f8fc74f34885c07814483d00100000730cc60406004889f04d89c5eb0231c0"].
 !store64[@templates + 1624 | 96].
