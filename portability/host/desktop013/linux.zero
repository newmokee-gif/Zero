# socketpair places its result through syscall argument four (R10).
? :hostsyscall[53|1|1|0|@pair|0|0] != 0 [ !exit[4]. ]
:load32[@pair] -> @a. :load32[@pair+4] -> @b.
? :hostsyscall[1|@a|"Zero"|4|0|0|0] != 4 [ !exit[5]. ]
? :hostsyscall[0|@b|@pair+8|4|0|0|0] != 4 [ !exit[6]. ]
