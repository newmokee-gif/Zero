                                ? @ch == 92 [ @pathUnits -> @separator. ]
                            ]
                        ]
                        @nodeIndex+2 -> @nodeIndex.
                    ]
                ]
                @index+@nodeBytes -> @index.
            ]
        ]
    ]
    ? @separator == 0 [ 0x8000000000000001 -> @status. ]
    ? @separator >= @pathUnits [ 0x8000000000000001 -> @status. ]
    ? :load16[@path] != 92 [ 0x8000000000000001 -> @status. ]
    ? @status == 0 [
        "system.iso" -> @text. 0 -> @index.
        ?? :load8[@text+@index] != 0 [
            !store16[@path+(@separator+@index)*2|:load8[@text+@index]].
