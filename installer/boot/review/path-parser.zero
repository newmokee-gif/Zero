# Resolve this application's directory from its loaded-image FILEPATH nodes.
# The firmware device is reused; no partition table or host file is changed.
? @status == 0 [
    :load64[@rootOut] -> @root.
    4 -> @step. 0 -> @done. 0 -> @index. 0 -> @pathUnits.
    ? @devicePath == 0 [ 0x8000000000000001 -> @status. ]
    ?? (@done == 0) * (@status == 0) [
        ? @index > 4092 [ 0x8000000000000001 -> @status. ] ~ [
            :load16[@devicePath+@index+2] -> @nodeBytes.
            ? @nodeBytes < 4 [ 0x8000000000000001 -> @status. ]
            ? @nodeBytes > 4096-@index [ 0x8000000000000001 -> @status. ]
            ? @status == 0 [
                ? (:load8[@devicePath+@index] == 127) * (:load8[@devicePath+@index+1] == 255) [
                    ? @nodeBytes != 4 [ 0x8000000000000001 -> @status. ]
                    1 -> @done.
                ] ~ [
                    ? :load8[@devicePath+@index] != 4 [ 0x8000000000000001 -> @status. ]
                    ? :load8[@devicePath+@index+1] != 4 [ 0x8000000000000001 -> @status. ]
                    ? @nodeBytes < 6 [ 0x8000000000000001 -> @status. ]
                    ? :bitand[@nodeBytes|1] [ 0x8000000000000001 -> @status. ]
                    4 -> @nodeIndex.
                    ?? (@nodeIndex < @nodeBytes) * (@status == 0) [
                        :load16[@devicePath+@index+@nodeIndex] -> @ch.
                        ? @nodeIndex+2 == @nodeBytes [
                            ? @ch != 0 [ 0x8000000000000001 -> @status. ]
                        ] ~ [
                            ? @ch == 0 [ 0x8000000000000001 -> @status. ]
                            ? @pathUnits >= 2036 [ 0x8000000000000001 -> @status. ]
                            ? @status == 0 [
