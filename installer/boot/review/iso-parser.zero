:reserve[16384] => @isoHead. @isoHead => @input. 16384 -> @need.
0 -> @received.
?? @received < @need [
 :read[@input+@received|@need-@received] -> @ch.
 ? @ch == 0 [ !exit[70]. ]
 ? @ch > @need-@received [ !exit[71]. ]
 @received+@ch -> @received.
]
? @status == 0 [
    7 -> @step.
    # Current Zero ISO identity, volume length, paired-endian blocks and root.
    ? :load64[@isoHead] != 0x0001313030444301 [ 0x8000000000000001 -> @status. ]
    "ZERO_SYSTEM" -> @text. 0 -> @index.
