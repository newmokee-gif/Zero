    ? :load32[@isoHead+2048+71] != 23 [ 0x8000000000000001 -> @status. ]
    ? :load64[@isoHead+4096] != 0x00013130304443ff [ 0x8000000000000001 -> @status. ]
    # El Torito validation checksum and BIOS/UEFI entries remain consistent.
    0 -> @checksum. 0 -> @index.
    ?? @index < 32 [
        @checksum+:load16[@isoHead+14336+@index] -> @checksum.
        @index+2 -> @index.
    ]
    ? :bitand[@checksum|65535] != 0 [ 0x8000000000000001 -> @status. ]
    ? :load16[@isoHead+14336] != 1 [ 0x8000000000000001 -> @status. ]
    ? :load16[@isoHead+14336+30] != 0xaa55 [ 0x8000000000000001 -> @status. ]
    ? :load16[@isoHead+14336+32] != 0x88 [ 0x8000000000000001 -> @status. ]
    ? :load16[@isoHead+14336+38] != 32 [ 0x8000000000000001 -> @status. ]
    ? :load32[@isoHead+14336+40] != 32 [ 0x8000000000000001 -> @status. ]
    ? :load32[@isoHead+14336+64] != 0x0001ef91 [ 0x8000000000000001 -> @status. ]
    ? :load16[@isoHead+14336+96] != 0x88 [ 0x8000000000000001 -> @status. ]
    ? :load16[@isoHead+14336+102] != 32768 [ 0x8000000000000001 -> @status. ]
