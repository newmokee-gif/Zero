                        ? :load8[@record+25] != 0 [ 0x8000000000000001 -> @status. ]
                        ? :load16[@record+26] != 0 [ 0x8000000000000001 -> @status. ]
                        ? :load32[@record+28] != 0x01000001 [ 0x8000000000000001 -> @status. ]
