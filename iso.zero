# Own ISO 9660 / El Torito BIOS + UEFI writer, compiled with zero --host.
# stdin: BIOS16KiB, kernels464/496KiB, FAT16 image16MiB, TOOLS.BIN1MiB.
# stdout: deterministic9224-sector ISO; payloads at32,40,272,520,8712.
:reserve[2048] => @sector.
:reserve[2048] => @payload.
0 => @number.
0 => @index.
0 => @text.
0 => @destination.
0 => @length.
0 => @record.
0 => @status.
0 => @received.
0 => @emitted.
0 => @checksum.
0 => @nameLength.

?? @number < 32 [
    0 -> @index.
    ?? @index < 2048 [
        !store64[@sector + @index| 0].
        @index + 8 -> @index.
    ]
    ? (@number >= 16) * (@number <= 18) [
        "CD001" -> @text.
        0 -> @index.
        ?? @index < 5 [
            !store8[@sector + 1 + @index| :load8[@text + @index]].
            @index + 1 -> @index.
        ]
        !store8[@sector + 6| 1].
    ]
    ? @number == 16 [
        !store8[@sector| 1].
        # The textual identifier fields use space padding.
        8 -> @index.
        ?? @index < 72 [ !store8[@sector + @index| 32]. @index + 1 -> @index. ]
        190 -> @index.
        ?? @index < 813 [ !store8[@sector + @index| 32]. @index + 1 -> @index. ]
        "ZERO" -> @text.
        0 -> @index.
        ?? @index < 4 [
            !store8[@sector + 8 + @index| :load8[@text + @index]].
            @index + 1 -> @index.
        ]
        "ZERO_SYSTEM" -> @text.
        0 -> @index.
        ?? @index < 11 [
            !store8[@sector + 40 + @index| :load8[@text + @index]].
            @index + 1 -> @index.
        ]
        "ZERO ISO WRITER" -> @text.
        0 -> @index.
        ?? @index < 15 [
            !store8[@sector + 574 + @index| :load8[@text + @index]].
            @index + 1 -> @index.
        ]
        # ISO dual-endian quantities: little-endian half, then big-endian.
        !store32[@sector + 80| 9224].
        !store32[@sector + 84| 0x08240000].
        !store16[@sector + 120| 1].
        !store16[@sector + 122| 0x0100].
        !store16[@sector + 124| 1].
        !store16[@sector + 126| 0x0100].
        !store16[@sector + 128| 2048].
        !store16[@sector + 130| 0x0008].
        !store32[@sector + 132| 10].
        !store32[@sector + 136| 0x0a000000].
        !store32[@sector + 140| 21].
        !store32[@sector + 148| 0x16000000].
        # The root directory record is filled by the common record loop.
        "1980010100000000" -> @text.
        0 -> @index.
        ?? @index < 16 [
            !store8[@sector + 813 + @index| :load8[@text + @index]].
            !store8[@sector + 830 + @index| :load8[@text + @index]].
            !store8[@sector + 847 + @index| 48].
            !store8[@sector + 864 + @index| :load8[@text + @index]].
            @index + 1 -> @index.
        ]
        # Timestamp zone bytes are zero: UTC. Expiration is unspecified.
        !store8[@sector + 881| 1].
    ]
    ? @number == 17 [
        # Boot Record Volume Descriptor: type zero, El Torito system ID.
        "EL TORITO SPECIFICATION" -> @text.
        0 -> @index.
        ?? @index < 23 [
            !store8[@sector + 7 + @index| :load8[@text + @index]].
            @index + 1 -> @index.
        ]
        !store32[@sector + 71| 23].
    ]
    ? @number == 18 [ !store8[@sector| 255]. ]

    # Shared record layout: PVD root, dot, dot-dot, and five sorted files.
    0 -> @length.
    ? @number == 16 [ @sector + 156 -> @destination. 1 -> @length. ]
    ? @number == 20 [ @sector -> @destination. 7 -> @length. ]
    0 -> @record.
    ?? @record < @length [
        !store8[@destination| 34].
        !store32[@destination + 2| 20].
        !store32[@destination + 6| 0x14000000].
        !store32[@destination + 10| 2048].
        !store32[@destination + 14| 0x00080000].
        # Directory-record timestamp: 1980-01-01 00:00:00 UTC.
        !store8[@destination + 18| 80].
        !store8[@destination + 19| 1].
        !store8[@destination + 20| 1].
        !store8[@destination + 25| 2].
        !store16[@destination + 28| 1].
        !store16[@destination + 30| 0x0100].
        !store8[@destination + 32| 1].
        ? @record == 1 [ !store8[@destination + 33| 1]. ]
        ? @record >= 2 [
            !store8[@destination| 44].
            !store32[@destination + 2| 32].
            !store32[@destination + 6| 0x20000000].
            !store32[@destination + 10| 16384].
            !store32[@destination + 14| 0x00400000].
            !store8[@destination + 25| 0].
            10 -> @nameLength.
            "BOOT.BIN;1" -> @text.
            ? @record == 3 [
                !store32[@destination + 2| 520].
                !store32[@destination + 6| 0x08020000].
                !store32[@destination + 10| 16777216].
                !store32[@destination + 14| 0x00000001].
                "BOOT.IMG;1" -> @text.
            ]
            ? @record == 4 [
                !store8[@destination| 46].
                !store32[@destination + 2| 40].
                !store32[@destination + 6| 0x28000000].
                !store32[@destination + 10| 475136].
                !store32[@destination + 14| 0x00400700].
                12 -> @nameLength.
                "KERNEL.BIN;1" -> @text.
            ]
            ? @record == 5 [
                !store8[@destination| 48].
                !store32[@destination + 2| 272].
                !store32[@destination + 6| 0x10010000].
                !store32[@destination + 10| 507904].
                !store32[@destination + 14| 0x00c00700].
                14 -> @nameLength.
                "KERNEL32.BIN;1" -> @text.
            ]
            ? @record == 6 [
                !store32[@destination+2|8712].
                !store32[@destination+6|0x08220000].
                !store32[@destination+10|1048576].
                !store32[@destination+14|0x00001000].
                11 -> @nameLength. "TOOLS.BIN;1" -> @text.
            ]
            !store8[@destination + 32| @nameLength].
            0 -> @index.
            ?? @index < @nameLength [
                !store8[@destination + 33 + @index| :load8[@text + @index]].
                @index + 1 -> @index.
            ]
        ]
        @destination + :load8[@destination] -> @destination.
        @record + 1 -> @record.
    ]
    ? @number == 21 [
        # Mandatory little-endian path table, one root directory.
        !store8[@sector| 1].
        !store32[@sector + 2| 20].
        !store16[@sector + 6| 1].
    ]
    ? @number == 22 [
        # Mandatory big-endian path table, same root directory.
        !store8[@sector| 1].
        !store32[@sector + 2| 0x14000000].
        !store16[@sector + 6| 0x0100].
    ]
    ? @number == 23 [
        # Validation entry: x86 platform 00, checksum and 55 AA key.
        !store8[@sector| 1].
        "ZERO BIOS AND UEFI" -> @text.
        0 -> @index.
        ?? @index < 18 [
            !store8[@sector + 4 + @index| :load8[@text + @index]].
            @index + 1 -> @index.
        ]
        !store16[@sector + 30| 0xaa55].
        0 -> @checksum.
        0 -> @index.
        ?? @index < 32 [
            @checksum + :load16[@sector + @index] -> @checksum.
            @index + 2 -> @index.
        ]
        !store16[@sector + 28| -@checksum].
        # BIOS default entry: bootable, no emulation, 16 KiB at LBA 32.
        # Load segment zero selects the El Torito default address 0000:7c00.
        !store8[@sector + 32| 0x88].
        !store16[@sector + 38| 32].
        !store32[@sector + 40| 32].
        # Final section header: EFI platform EF, one following boot entry.
        !store8[@sector + 64| 0x91].
        !store8[@sector + 65| 0xef].
        !store16[@sector + 66| 1].
        # EFI entry: both fallback architectures share a FAT image atLBA520.
        # Load counts use 512-byte sectors; addresses use ISO 2048-byte LBAs.
        !store8[@sector + 96| 0x88].
        !store16[@sector + 102| 32768].
        !store32[@sector + 104| 520].
    ]
    0 -> @emitted.
    ?? @emitted < 2048 [
        :write[@sector + @emitted| 2048 - @emitted] -> @status.
        ? @status != -4 [
            ? @status == 0 [ !exit[4]. ]
            ? @status > 2048 - @emitted [ !exit[4]. ]
            @emitted + @status -> @emitted.
        ]
    ]
    @number + 1 -> @number.
]

# Copy all five payloads unchanged, with only two 2048-byte buffers.
?? @number < 9224 [
    0 -> @received.
    ?? @received < 2048 [
        :read[@payload + @received| 2048 - @received] -> @status.
        ? @status != -4 [
            ? @status == 0 [ !exit[2]. ]
            ? @status > 2048 - @received [ !exit[1]. ]
            @received + @status -> @received.
        ]
    ]
    ? @number == 8712 [
        ? :load64[@payload] != 0x31304c444e42525a [ !exit[2]. ]
        ? :load64[@payload+8] != 1 [ !exit[2]. ]
        ? :load64[@payload+16] != 1048576 [ !exit[2]. ]
        ? :load64[@payload+24] != 8 [ !exit[2]. ]
    ]
    ? @number == 520 [
        # Check the FAT16 image at its actual input boundary. El Torito BIOS
        # stages need no 55 AA signature, and their machine code is opaque.
        ? :load16[@payload + 11] != 512 [ !exit[2]. ]
        ? :load8[@payload + 13] != 1 [ !exit[2]. ]
        ? :load16[@payload + 14] != 1 [ !exit[2]. ]
        ? :load8[@payload + 16] != 2 [ !exit[2]. ]
        ? :load16[@payload + 17] != 512 [ !exit[2]. ]
        ? :load16[@payload + 19] != 32768 [ !exit[2]. ]
        ? :load16[@payload + 22] != 128 [ !exit[2]. ]
        ? :load16[@payload + 510] != 0xaa55 [ !exit[2]. ]
    ]
    0 -> @emitted.
    ?? @emitted < 2048 [
        :write[@payload + @emitted| 2048 - @emitted] -> @status.
        ? @status != -4 [
            ? @status == 0 [ !exit[4]. ]
            ? @status > 2048 - @emitted [ !exit[4]. ]
            @emitted + @status -> @emitted.
        ]
    ]
    @number + 1 -> @number.
]
# Require EOF after exactly16384+475136+507904+16777216+1048576 input bytes.
-4 -> @status.
?? @status == -4 [ :read[@payload| 1] -> @status. ]
? @status > 1 [ !exit[1]. ]
? @status != 0 [ !exit[3]. ]
!exit[0].
