# Native PCI mechanism1 probe; the enclosing BIOS supplies normal kernel entry.
:in32[0xcf8] => @saved.
0 => @failed.
!out32[0xffff0cf8 | 0x80000000].
? :in32[0xcf8] != 0x80000000 [ 1 -> @failed. ]
:in32[0xffff0cfc] => @identity.
? @identity != 0x12378086 [ 1 -> @failed. ]
# Read a nonexistent device: all low32 bits set, all high32 bits clear.
!out32[0xcf8 | 0x80fff800].
:in32[0xcfc] => @absent.
? @absent != 4294967295 [ 1 -> @failed. ]
!out32[0xcf8 | @saved].
"PORT32 PASS\n" => @text.
? @failed [ "PORT32 FAIL\n" -> @text. ]
0 => @i.
?? :load8[@text + @i] [ !out8[0xe9 | :load8[@text + @i]]. @i + 1 -> @i. ]
!out8[0xf4 | @failed].
!halt.
