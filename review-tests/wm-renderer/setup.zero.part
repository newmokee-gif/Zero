? @i == 1 [
 ? :load8[@echo_byte] == 115 [ !store64[@console + 2080 | 1]. !store64[@console + 2064 | 1]. ]
 ? :load8[@echo_byte] == 114 [ !store64[@console + 40 | 0]. ]
]
0 -> @k.
?? @k < 3 [
 @pointer + @k * 8192 -> @c0.
 !store64[@c0 | 1]. !store64[@c0 + 8 | @k + 1]. !store64[@c0 + 64 | 1].
 "A:|> help\r\nZero windows.\r\nA:|> write FIRST\r\nFIRST\r\nA:|> " -> @message.
 ? @k == 1 [ "B:|> read second\r\nSecond terminal\r\nB:|> " -> @message. ]
 ? @k == 2 [ "A:|> tasks\r\nterminal RUN\r\ngraphics RUN\r\ncompute RUN\r\nA:|> " -> @message. ]
 0 -> @i. ?? :load8[@message + @i] [ !store8[@c0 + 1024 + @i | :load8[@message + @i]]. @i + 1 -> @i. ]
 !store64[@c0 + 16 | @i]. !store64[@c0 + 24 | @i].
 @k + 1 -> @k.
]
