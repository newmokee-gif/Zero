
:reserve[1958656] -> @file.
!store64[@console + 2000 | @file].
0 -> @i.
?? @i < 1958656 [ !store32[@file + @i | 0x5a5a5a5a]. @i + 4 -> @i. ]
!store64[@console | 2]. !store64[@console + 8 | @file + 128].
!store64[@console + 16 | 800]. !store64[@console + 24 | 600].
!store64[@console + 32 | 816]. !store64[@console + 40 | 1].
:reserve[24576] -> @pointer.
0 -> @i. ?? @i < 24576 [ !store8[@pointer + @i | 0]. @i + 1 -> @i. ]
!store64[@console + 2048 | @pointer]. !store64[@console + 2056 | 3].
!store64[@console + 2064 | 0]. !store64[@console + 2072 | 3].
!store64[@console + 2080 | 0]. !store64[@console + 2088 | 1].
