# Original IA32 UEFI loader in Zero. Firmware interfaces use 32-bit cdecl.
# UINTN/pointers are u32; physical addresses, file sizes and our handoff are u64.
:arg0[] => @image.
:arg1[] => @system.
:load32[@system + 60] => @services.
0 => @status.
:reserve[1024] => @scratch.
@scratch => @guid.
@scratch + 32 => @result.
@scratch + 40 => @rootOut.
@scratch + 48 => @fileOut.
@scratch + 56 => @sizeOut.
@scratch + 80 => @path.
@scratch + 256 => @fileInfo.
"ZERO IA32 loader: UEFI -> own kernel\r\n" => @text.
0 => @index.
0 => @ch.
0 => @protocol.
0 => @device.
0 => @root.
0 => @file.
0 => @fileSize.
0 => @code.
0 => @bundle.
0 => @workspace.
0 => @received.
0 => @stack.
0 => @handoff.
0 => @map.
0 => @attempts.
0 => @step.
0 => @done.
0 => @uart.
0 => @wait.
1 => @serial.
0 => @gop.
0 => @mode.
0 => @modeInfo.
0 => @maxMode.
0 => @candidate.
0xffffffff => @chosenMode.
0xffffffff => @fallbackMode.
0 => @fallbackRank.
0 => @modeRank.
0 => @gopStatus.
0 => @width.
0 => @height.
0 => @stride.
0 => @pixelKind.
0 => @frameBuffer.
0 => @frameBytes.
0 => @screenValid.
# Own UART setup for loader diagnostics.
!out8[0x3f9|0].
!out8[0x3fb|128].
!out8[0x3f8|1].
!out8[0x3f9|0].
!out8[0x3fb|3].
!out8[0x3fa|199].
!out8[0x3fc|11].
:in8[0x3fd] -> @uart.
? @uart == 255 [ 0 -> @serial. ]
?? (:load8[@text+@index] != 0) * @serial [
    0 -> @uart. 0 -> @wait.
    ?? (@uart < 32) * @serial [
        :in8[0x3fd] -> @uart.
        ? @uart >= 128 [ @uart-128 -> @uart. ]
        ? @uart >= 64 [ @uart-64 -> @uart. ]
        @wait+1 -> @wait.
        ? @wait > 1000000 [ 0 -> @serial. ]
    ]
    ? @serial [ !out8[0x3f8|:load8[@text+@index]]. ]
    @index+1 -> @index.
]
# Disable firmware watchdog before leaving firmware.
:call[:load32[@services+140]|0|0|0|0|0] -> @status.
? @status == 0 [
    1 -> @step.
    # EFI_LOADED_IMAGE_PROTOCOL on this application handle.
    !store64[@guid|0x11d295625b1b31a1].
    !store64[@guid+8|0x3b7269c9a0003f8e].
    !store64[@result|0].
    :call[:load32[@services+88]|@image|@guid|@result|0|0] -> @status.
]
? @status == 0 [
    :load32[@result] -> @protocol.
    :load32[@protocol+12] -> @device.
    2 -> @step.
    !store64[@guid|0x11d26459964e5b22].
    !store64[@guid+8|0x3b7269c9a000398e].
    !store64[@result|0].
    :call[:load32[@services+88]|@device|@guid|@result|0|0] -> @status.
]
? @status == 0 [
    :load32[@result] -> @protocol.
    3 -> @step.
    !store64[@rootOut|0].
    :call[:load32[@protocol+8]|@protocol|@rootOut|0|0|0] -> @status.
]
? @status == 0 [
    :load32[@rootOut] -> @root.
    "\\kernel32.bin" -> @text.
    0 -> @index.
    ?? :load8[@text+@index] != 0 [
        !store16[@path+@index*2|:load8[@text+@index]].
        @index+1 -> @index.
    ]
    !store16[@path+@index*2|0].
    4 -> @step.
    !store64[@fileOut|0].
    :call7[:load32[@root+8]|@root|@fileOut|@path|1|0|0|0] -> @status.
]
? @status == 0 [
    :load32[@fileOut] -> @file.
    5 -> @step.
    !store64[@guid|0x11d26d3f09576e92].
    !store64[@guid+8|0x3b7269c9a000398e].
    !store32[@sizeOut|512].
    :call[:load32[@file+36]|@file|@guid|@sizeOut|@fileInfo|0] -> @status.
    ? @status == 0 [
        ? :load32[@sizeOut] < 80 [ 0x80000001 -> @status. ]
        ? :load32[@sizeOut] > 512 [ 0x80000001 -> @status. ]
        ? @status == 0 [
            :load64[@fileInfo+8] -> @fileSize.
            ? @fileSize == 0 [ 0x80000001 -> @status. ]
            ? @fileSize > 507904 [ 0x80000001 -> @status. ]
        ]
    ]
]
? @status == 0 [
    6 -> @step.
    !store64[@result|0xffffefff].
    :call[:load32[@services+32]|1|1|124|@result|0] -> @status.
    :load64[@result] -> @code.
    ? @status == 0 [ ? @code > 0xfff83000 [ 0x80000001 -> @status. ] ]
]
# File completion has its own flag; no EFI warning can mean completion.
?? @done == 0 [
    ? @status != 0 [ 1 -> @done. ] ~ [
        ? @received == @fileSize [ 1 -> @done. ] ~ [
            7 -> @step.
            !store32[@sizeOut|@fileSize-@received].
            :call[:load32[@file+20]|@file|@sizeOut|@code+@received|0|0] -> @status.
            ? @status == 0 [
                :load32[@sizeOut] -> @ch.
                ? @ch == 0 [ 0x80000001 -> @status. ]
                ? @ch > @fileSize-@received [ 0x80000001 -> @status. ]
                ? @status == 0 [ @received+@ch -> @received. ]
            ]
        ]
    ]
]
? @status == 0 [
    8 -> @step.
    :call[:load32[@file+12]|@file|0|0|0|0] -> @status.
]
# Native language tools are part of the boot medium, loaded before firmware exit.
? @status == 0 [
    11 -> @step.
    "\\tools.bin" -> @text. 0 -> @index.
    ?? :load8[@text+@index] != 0 [
        !store16[@path+@index*2|:load8[@text+@index]]. @index+1 -> @index.
    ]
    !store16[@path+@index*2|0]. !store64[@fileOut|0].
    :call7[:load32[@root+8]|@root|@fileOut|@path|1|0|0|0] -> @status.
]
? @status == 0 [
    :load32[@fileOut] -> @file.
    12 -> @step.
    !store32[@sizeOut|512].
    :call[:load32[@file+36]|@file|@guid|@sizeOut|@fileInfo|0] -> @status.
    ? @status == 0 [
        ? :load32[@sizeOut] < 80 [ 0x80000001 -> @status. ]
        ? :load32[@sizeOut] > 512 [ 0x80000001 -> @status. ]
        ? @status == 0 [
            ? :load64[@fileInfo+8] != 1048576 [ 0x80000001 -> @status. ]
        ]
    ]
]
? @status == 0 [
    13 -> @step.
    # LoaderCode permits execution of native tools and their generated programs.
    !store64[@result|0xffffefff].
    :call[:load32[@services+32]|1|1|256|@result|0] -> @status.
    :load64[@result] -> @bundle.
    ? @status == 0 [
        ? @bundle == 0 [ 0x80000001 -> @status. ]
        ? @bundle+1048576 <= @bundle [ 0x80000001 -> @status. ]
        ? @bundle > 0xffeff000 [ 0x80000001 -> @status. ]
    ]
]
0 -> @received. 0 -> @done.
?? @done == 0 [
    ? @status != 0 [ 1 -> @done. ] ~ [
        ? @received == 1048576 [ 1 -> @done. ] ~ [
            14 -> @step.
            !store32[@sizeOut|1048576-@received].
            :call[:load32[@file+20]|@file|@sizeOut|@bundle+@received|0|0] -> @status.
            ? @status == 0 [
                :load32[@sizeOut] -> @ch.
                ? @ch == 0 [ 0x80000001 -> @status. ]
                ? @ch > 1048576-@received [ 0x80000001 -> @status. ]
                ? @status == 0 [ @received+@ch -> @received. ]
            ]
        ]
    ]
]
? @status == 0 [
    ? :load64[@bundle] != 0x31304c444e42525a [ 0x80000001 -> @status. ]
    ? :load64[@bundle+8] != 1 [ 0x80000001 -> @status. ]
    ? :load64[@bundle+16] != 1048576 [ 0x80000001 -> @status. ]
    ? :load64[@bundle+24] != 8 [ 0x80000001 -> @status. ]
]
? @status == 0 [
    15 -> @step.
    :call[:load32[@file+12]|@file|0|0|0|0] -> @status.
    ? @status == 0 [ :call[:load32[@root+12]|@root|0|0|0|0] -> @status. ]
]
? @status == 0 [
    16 -> @step.
    !store64[@result|0xffffefff].
    :call[:load32[@services+32]|1|1|2048|@result|0] -> @status.
    :load64[@result] -> @workspace.
    ? @status == 0 [
        ? @workspace == 0 [ 0x80000001 -> @status. ]
        ? @workspace+8388608 <= @workspace [ 0x80000001 -> @status. ]
        ? @workspace > 0xff7ff000 [ 0x80000001 -> @status. ]
    ]
]
? @status == 0 [
    9 -> @step.
    !store64[@result|0xffffefff].
    :call[:load32[@services+32]|1|2|256|@result|0] -> @status.
    :load64[@result] -> @stack.
    ? @status == 0 [ ? @stack > 0xffeff000 [ 0x80000001 -> @status. ] ]
]
? @status == 0 [
    10 -> @step.
    !store64[@result|0xffffefff].
    :call[:load32[@services+32]|1|2|17|@result|0] -> @status.
    :load64[@result] -> @handoff.
    ? @status == 0 [ ? @handoff > 0xfffee000 [ 0x80000001 -> @status. ] ]
    @handoff+4096 -> @map.
]
? @status == 0 [
    # The handoff is LoaderData, not implicitly initialized firmware memory.
    0 -> @index.
    ?? @index < 256 [ !store64[@handoff+@index|0]. @index+8 -> @index. ]
    !store64[@handoff+96|2].
    !store64[@handoff+104|32].
    !store64[@handoff+112|@stack].
    !store64[@handoff+120|1048576].
    !store64[@handoff+128|@bundle].
    !store64[@handoff+136|1048576].
    !store64[@handoff+144|@workspace].
    !store64[@handoff+152|8388608].
    # Obtain GOP while firmware services are still available. Failure leaves
    # display kind zero, preserving serial-only operation on headless systems.
    !store64[@guid|0x4a3823dc9042a9de].
    !store64[@guid+8|0x6a5180d0de7afb96].
    !store64[@result|0].
    :call[:load32[@services+172]|@guid|0|@result|0|0] -> @gopStatus.
    ? @gopStatus == 0 [ :load32[@result] -> @gop. ]
    ? @gop [
        :load32[@gop+12] -> @mode.
        ? @mode [
            :load32[@mode] -> @maxMode.
            # Preserve a valid active FullHD mode without resetting it.
            :load32[@mode+8] -> @modeInfo.
            ? @modeInfo [
                ? :load32[@mode+12] >= 36 [
                    :load32[@modeInfo+4] -> @width.
                    :load32[@modeInfo+8] -> @height.
                    :load32[@modeInfo+32] -> @stride.
                    1 -> @screenValid.
                    ? :load32[@modeInfo] != 0 [ 0 -> @screenValid. ]
                    ? @width != 1920 [ 0 -> @screenValid. ]
                    ? @height != 1080 [ 0 -> @screenValid. ]
                    ? @stride < @width [ 0 -> @screenValid. ]
                    ? @stride > 16384 [ 0 -> @screenValid. ]
                    ? :load32[@modeInfo+12] > 1 [ 0 -> @screenValid. ]
                    :load64[@mode+16] -> @frameBuffer.
                    @stride*@height*4 -> @frameBytes.
                    ? @frameBuffer == 0 [ 0 -> @screenValid. ]
                    ? @frameBuffer > 0xffffffff [ 0 -> @screenValid. ]
                    ? @frameBuffer+@frameBytes > 0x100000000 [ 0 -> @screenValid. ]
                    ? @frameBytes > :load32[@mode+24] [ 0 -> @screenValid. ]
                    ? @frameBuffer+@frameBytes <= @frameBuffer [ 0 -> @screenValid. ]
                    ? :load32[@mode+4] >= @maxMode [ 0 -> @screenValid. ]
                    ? @screenValid [ :load32[@mode+4] -> @chosenMode. ]
                ]
            ]
            0 -> @candidate.
            # QueryMode allocates Info. Free it on every successful query;
            # only values copied to our own variables survive FreePool.
            # Keep searching after finding FullHD so a validated lower mode
            # remains available if firmware refuses the preferred SetMode.
            ? @chosenMode == 0xffffffff [
            ?? (@candidate < @maxMode) * (@candidate < 256) [
                !store64[@scratch+64|0].
                !store64[@scratch+72|0].
                :call[:load32[@gop]|@gop|@candidate|@scratch+64|@scratch+72|0] -> @gopStatus.
                ? @gopStatus == 0 [
                    :load32[@scratch+72] -> @modeInfo.
                    ? @modeInfo [
                        0 -> @screenValid.
                        ? :load32[@scratch+64] >= 36 [
                            :load32[@modeInfo+4] -> @width.
                            :load32[@modeInfo+8] -> @height.
                            :load32[@modeInfo+32] -> @stride.
                            1 -> @screenValid.
                            ? :load32[@modeInfo] != 0 [ 0 -> @screenValid. ]
                            ? @width < 640 [ 0 -> @screenValid. ]
                            ? @width > 1920 [ 0 -> @screenValid. ]
                            ? @height < 400 [ 0 -> @screenValid. ]
                            ? @height > 1080 [ 0 -> @screenValid. ]
                            ? @stride < @width [ 0 -> @screenValid. ]
                            ? @stride > 16384 [ 0 -> @screenValid. ]
                            ? :load32[@modeInfo+12] > 1 [ 0 -> @screenValid. ]
                        ]
                        :call[:load32[@services+48]|@modeInfo|0|0|0|0] -> @gopStatus.
                        ? @gopStatus != 0 [ 0 -> @screenValid. 256 -> @candidate. ]
                        ? @screenValid [
                            ? (@width == 1920) * (@height == 1080) [
                                ? @chosenMode == 0xffffffff [ @candidate -> @chosenMode. ]
                            ] ~ [
                                1 -> @modeRank.
                                ? (@width == 640) * (@height == 480) [ 2 -> @modeRank. ]
                                ? (@width == 800) * (@height == 600) [ 3 -> @modeRank. ]
                                ? @modeRank > @fallbackRank [
                                    @candidate -> @fallbackMode. @modeRank -> @fallbackRank.
                                ]
                            ]
                        ]
                    ]
                ]
                @candidate+1 -> @candidate.
            ]
            ]
            ? @chosenMode == 0xffffffff [ @fallbackMode -> @chosenMode. ]
            ? @chosenMode != 0xffffffff [
                ? @chosenMode != :load32[@mode+4] [
                    :call[:load32[@gop+4]|@gop|@chosenMode|0|0|0] -> @gopStatus.
                ]
