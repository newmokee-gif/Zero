? @status != 0 [
    "ZERO IA32 loader: failed before exit; stage=" -> @text.
    0 -> @index.
    ?? (:load8[@text+@index] != 0) * @serial [
        0 -> @uart. 0 -> @wait.
        ?? (@uart < 32) * @serial [
            :in8[0x3fd] -> @uart.
            ? @uart >= 128 [ @uart-128 -> @uart. ]
            ? @uart >= 64 [ @uart-64 -> @uart. ]
            @wait+1 -> @wait.
            ? @wait > 1000000 [ 0 -> @serial. ]
        ]
        ? @serial [ !out8[0x3f8|:load8[@text+@index]]. ] @index+1 -> @index.
    ]
    # Format stages 0..16 in decimal and poll before every diagnostic byte.
    0 -> @index.
    ? @step >= 10 [ !store8[@path|49]. 1 -> @index. @step-10 -> @step. ]
    !store8[@path+@index|48+@step].
    !store8[@path+@index+1|13].
    !store8[@path+@index+2|10].
    !store8[@path+@index+3|0].
    0 -> @index.
    ?? (:load8[@path+@index] != 0) * @serial [
        0 -> @uart. 0 -> @wait.
        ?? (@uart < 32) * @serial [
            :in8[0x3fd] -> @uart.
            ? @uart >= 128 [ @uart-128 -> @uart. ]
            ? @uart >= 64 [ @uart-64 -> @uart. ]
            @wait+1 -> @wait.
            ? @wait > 1000000 [ 0 -> @serial. ]
        ]
        ? @serial [ !out8[0x3f8|:load8[@path+@index]]. ] @index+1 -> @index.
    ]
    !halt.
]
# Handoff header +0 size, +8 stride, +16 map, +24 code pages;
# +32 map key, +40 descriptor version. All in our allocated LoaderData.
!store64[@handoff+16|@map].
!store64[@handoff+24|120].
"ZERO IA32 loader: leaving boot services\r\n" -> @text.
0 -> @index.
?? (:load8[@text+@index] != 0) * @serial [
    0 -> @uart. 0 -> @wait.
    ?? (@uart < 32) * @serial [
        :in8[0x3fd] -> @uart.
        ? @uart >= 128 [ @uart-128 -> @uart. ]
        ? @uart >= 64 [ @uart-64 -> @uart. ]
        @wait+1 -> @wait.
        ? @wait > 1000000 [ 0 -> @serial. ]
    ]
    ? @serial [ !out8[0x3f8|:load8[@text+@index]]. ] @index+1 -> @index.
]
# After the first attempt only GetMemoryMap/ExitBootServices may use firmware.
# Retry within the preallocated 64 KiB map; diagnostics use our UART only.
0 -> @done.
?? @done == 0 [
    !store64[@handoff|65536].
    :call[:load32[@services+40]|@handoff|@map|@handoff+32|@handoff+8|@handoff+40] -> @status.
    ? @status != 0 [
        "ZERO IA32 loader: GetMemoryMap failed\r\n" -> @text.
        1 -> @done.
    ] ~ [
        ? :load64[@handoff] > 65536 [ 1 -> @done. ]
        ? :load64[@handoff+8] < 40 [ 1 -> @done. ]
        ? :load64[@handoff+8] > :load64[@handoff] [ 1 -> @done. ]
        ? @done != 0 [
            "ZERO IA32 loader: invalid memory map\r\n" -> @text.
        ] ~ [
            :call[:load32[@services+128]|@image|:load64[@handoff+32]|0|0|0] -> @status.
            ? @status == 0 [
                !enter[@code|@handoff|@stack+1048576].
            ]
            @attempts+1 -> @attempts.
            ? @status != 0x80000002 [
                "ZERO IA32 loader: ExitBootServices failed\r\n" -> @text.
                1 -> @done.
            ] ~ [
                ? @attempts == 4 [
                    "ZERO IA32 loader: ExitBootServices retry limit\r\n" -> @text.
                    1 -> @done.
                ]
            ]
        ]
    ]
]
0 -> @index.
?? (:load8[@text+@index] != 0) * @serial [
    0 -> @uart. 0 -> @wait.
    ?? (@uart < 32) * @serial [
        :in8[0x3fd] -> @uart.
        ? @uart >= 128 [ @uart-128 -> @uart. ]
        ? @uart >= 64 [ @uart-64 -> @uart. ]
        @wait+1 -> @wait.
        ? @wait > 1000000 [ 0 -> @serial. ]
    ]
    ? @serial [ !out8[0x3f8|:load8[@text+@index]]. ] @index+1 -> @index.
]
!halt.
